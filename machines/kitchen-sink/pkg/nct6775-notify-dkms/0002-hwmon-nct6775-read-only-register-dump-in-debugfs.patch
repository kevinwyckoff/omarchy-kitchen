From: kitchen <noreply@example.invalid>
Subject: [PATCH] hwmon: (nct6775) read-only register dump in debugfs

Whether the hardware-monitor interrupt can be used on a board depends on
how firmware set up the Super-I/O: the interrupt number in logical
device B CR70, the SMI#/OVT# pin modes (CR1B, CR24, CR25, logical device
D CRE2) and the SMI mask, mode and OVT registers of the hardware
monitor. None of that is visible from sysfs, and reading it from
userspace (isadump) races the driver's cached bank select and can leave
the chip in the wrong bank.

Add two root-only debugfs files per device, nct6775/<device>/sio_regs
and hm_regs, that read these registers through the driver itself:
configuration space with the driver's own enter and exit sequence under
the muxed Super-I/O region (the logical-device select is put back
afterwards), and the hardware monitor through the regmap under
update_lock.

Nothing else is written, and no read-to-clear register is ever read, in
either space. In the hardware monitor these are the interrupt status
registers (bank 0 0x41, 0x42, 0x45, 0x450, 0x567, 0xc02, 0xc03): every
dump read goes through one helper that refuses them, including as the
second byte of a word-sized register. In configuration space they are the
GPIO event status registers (logical device 7 CRE3, CRE7, CRF7; 8 CRE3,
CRF3; 9 CRE3, CRE7, CRE8, CRF7) and logical device A CRE3, the thermal
shutdown, PSIN and wake-up event status that firmware reads around sleep;
the configuration-space loop checks that list before each read. Neither
list is in the dump's register lists today; the checks keep a longer list
from clearing status firmware relies on. A refused register shows as
"denied".

Reading either file returns -EPERM unless the new dump parameter is set
(root can change it at runtime), so debugfs crawlers do not enter
configuration mode by accident. The files exist only for nct6796 and
nct6799 with direct I/O: the register lists come from the NCT6796D
datasheet.

Signed-off-by: (unsigned local patch)
---
--- a/drivers/hwmon/nct6775-platform.c
+++ b/drivers/hwmon/nct6775-platform.c
@@ -9,14 +9,17 @@
 #define pr_fmt(fmt) KBUILD_MODNAME ": " fmt
 
 #include <linux/acpi.h>
+#include <linux/debugfs.h>
 #include <linux/dmi.h>
 #include <linux/hwmon-sysfs.h>
 #include <linux/hwmon-vid.h>
 #include <linux/init.h>
 #include <linux/io.h>
 #include <linux/module.h>
+#include <linux/mutex.h>
 #include <linux/platform_device.h>
 #include <linux/regmap.h>
+#include <linux/seq_file.h>
 
 #include "nct6775.h"
 
@@ -46,6 +49,16 @@
 module_param(fan_debounce, ushort, 0);
 MODULE_PARM_DESC(fan_debounce, "Enable debouncing for fan RPM signal");
 
+/*
+ * The debugfs register dump is off unless asked for: reading it enters the
+ * Super-I/O configuration mode, which firmware (SMM) may use at the same time.
+ * Root can switch it at runtime, so no reload is needed to take a dump.
+ */
+static bool dump;
+module_param(dump, bool, 0644);
+MODULE_PARM_DESC(dump,
+		 "Allow reading the read-only register dump in debugfs (nct6775/<device>/{sio_regs,hm_regs})");
+
 #define DRVNAME "nct6775"
 
 #define NCT6775_PORT_CHIPID	0x58
@@ -924,6 +937,274 @@
 	return nct6775_add_attr_group(data, &nct6775_group_other);
 }
 
+/*
+ * Read-only register dump in debugfs, to see how firmware set up the chip's
+ * interrupt, SMI# and OVT# routing: /sys/kernel/debug/nct6775/<device>/
+ *
+ *   sio_regs  Super-I/O configuration registers
+ *   hm_regs   hardware-monitor SMI/OVT configuration registers
+ *
+ * Both files are root-only, never write a chip register other than the
+ * logical-device and bank selects that every read needs, never read a
+ * read-to-clear register (in either space), and return -EPERM unless the
+ * dump parameter is set. They exist only for the NCT6796D register
+ * map (nct6796, nct6799) with direct I/O; the register lists below come from
+ * the NCT6796D datasheet and are not known to be safe on other chips.
+ */
+static struct dentry *nct6775_debugfs_root;
+
+/*
+ * The interrupt status registers are cleared by reading them, so a read
+ * would steal events from firmware (SMM) or a future interrupt handler. The
+ * dump never reads them, whatever the register list says: every dump read
+ * goes through nct6775_dump_hm_read(), which checks this list first.
+ * NCT6796D datasheet v0.6, sections 9.21, 9.22, 9.25, 9.191, 9.241, 9.452
+ * and 9.453.
+ */
+static const u16 nct6775_dump_never_read[] = {
+	0x041, 0x042, 0x045,	/* bank 0: interrupt status 1, 2 and 4 */
+	0x450,			/* bank 4: interrupt status 3 */
+	0x567,			/* bank 5: interrupt status */
+	0xc02, 0xc03,		/* bank C: interrupt status */
+};
+
+/* Hardware-monitor registers in the dump: SMI#/OVT# setup, masks, SMIOVT slots */
+static const u16 nct6775_dump_hm_regs[] = {
+	0x018,			/* OVT# configuration */
+	0x039, 0x03a,		/* SMIOVT1 high limit and hysteresis */
+	0x040,			/* configuration (SMI# and interrupt enables) */
+	0x043, 0x044, 0x046,	/* SMI# masks 1, 2 and 3 */
+	0x04c,			/* SMI/OVT control 1 */
+	0x152,			/* SMIOVT2 source configuration */
+	0x153, 0x154,		/* SMIOVT2 hysteresis, high and low byte */
+	0x155, 0x156,		/* SMIOVT2 over-temperature, high and low byte */
+	0x451,			/* SMI# mask 4 */
+	0x566,			/* SMI# mask (bank 5) */
+	0x621, 0x622,		/* SMIOVT1 and SMIOVT2 source select */
+	0xc04, 0xc05,		/* SMI3-8# masks */
+	0xc06,			/* SMI/OVT3-8 control (DIS_OVT3-8) */
+	0xc07, 0xc08, 0xc0c, 0xc0d,	/* SMIOVT3-8 source configuration */
+	0xc1a, 0xc1b, 0xc1c, 0xc1d, 0xc1e, 0xc1f,	/* SMIOVT3-8 over-temperature */
+	0xc20, 0xc21, 0xc22, 0xc23, 0xc24, 0xc25,	/* SMIOVT3-8 hysteresis */
+	0xc26, 0xc27, 0xc28, 0xc29, 0xc2a, 0xc2b,	/* SMIOVT3-8 source select */
+};
+
+/*
+ * Configuration space has read-to-clear registers too: the GPIO event status
+ * registers, and logical device A's CRE3, whose thermal-shutdown, PSIN and
+ * keyboard/mouse wake-up status firmware reads around sleep (on the ASRock
+ * B650M-HDV/M.2, SIO1.SIOS/SIOW from _PTS and _WAK). The dump never reads
+ * them either, whatever its list says: the loop in nct6775_sio_regs_show()
+ * checks this list before every read. NCT6796D datasheet v0.6, section 24.
+ */
+static const struct {
+	u8 ld, reg;
+} nct6775_dump_sio_never_read[] = {
+	{ 0x07, 0xe3 }, { 0x07, 0xe7 }, { 0x07, 0xf7 },	/* GPIO7, GPIO8, GPIO6 status */
+	{ 0x08, 0xe3 }, { 0x08, 0xf3 },			/* GPIO0, GPIO1 status */
+	{ 0x09, 0xe3 }, { 0x09, 0xe7 }, { 0x09, 0xe8 },	/* GPIO2, GPIO3, GPIO4 status */
+	{ 0x09, 0xf7 },					/* GPIO5 status */
+	{ NCT6775_LD_ACPI, 0xe3 },			/* event status */
+};
+
+/*
+ * Super-I/O configuration registers in the dump; none is on the list above.
+ * CR26 bit 4 (which would expose CR10-CR14) is left alone.
+ */
+static const struct {
+	s8 ld;			/* logical device, -1 for the global registers */
+	u8 first, last;
+} nct6775_dump_sio_regs[] = {
+	{ -1, 0x1a, 0x2f },		/* multi-function pins, SMI#/OVT# pin modes */
+	{ NCT6775_LD_HWM, 0x30, 0x30 },	/* hardware monitor: enable */
+	{ NCT6775_LD_HWM, 0x60, 0x65 },	/* base addresses */
+	{ NCT6775_LD_HWM, 0x70, 0x70 },	/* interrupt (SERIRQ) number */
+	{ NCT6775_LD_HWM, 0xe0, 0xff },
+	{ NCT6775_LD_ACPI, 0xe7, 0xe7 },
+	{ NCT6775_LD_ACPI, 0xf2, 0xf7 },	/* PME enables and status */
+	{ NCT6775_LD_VID, 0xe2, 0xe2 },	/* OVT#_2/SMI#_2 pin mode */
+};
+
+#define NCT6775_DUMP_SIO_MAX	96	/* room for the registers listed above (70) */
+
+static bool nct6775_dump_denied(u16 reg)
+{
+	int i;
+
+	for (i = 0; i < ARRAY_SIZE(nct6775_dump_never_read); i++)
+		if (reg == nct6775_dump_never_read[i])
+			return true;
+	return false;
+}
+
+/* ld is the logical device selected; the global registers (ld < 0) are all safe */
+static bool nct6775_dump_sio_denied(int ld, u8 reg)
+{
+	int i;
+
+	for (i = 0; i < ARRAY_SIZE(nct6775_dump_sio_never_read); i++)
+		if (ld == nct6775_dump_sio_never_read[i].ld &&
+		    reg == nct6775_dump_sio_never_read[i].reg)
+			return true;
+	return false;
+}
+
+/*
+ * The only way the dump reads a hardware-monitor register. A word-sized
+ * register is read together with the next address, so both are checked.
+ * Called with data->update_lock held; the regmap keeps the bank select in
+ * step with the driver's cached bank.
+ */
+static int nct6775_dump_hm_read(struct nct6775_data *data, u16 reg, u8 *val)
+{
+	bool word = nct6775_reg_is_word_sized(data, reg);
+	u16 tmp;
+	int err;
+
+	if (nct6775_dump_denied(reg) || (word && nct6775_dump_denied(reg + 1)))
+		return -EPERM;
+
+	err = nct6775_read_value(data, reg, &tmp);
+	if (err)
+		return err;
+
+	*val = word ? tmp >> 8 : tmp;
+	return 0;
+}
+
+static int nct6775_hm_regs_show(struct seq_file *s, void *unused)
+{
+	struct nct6775_data *data = s->private;
+	u8 val[ARRAY_SIZE(nct6775_dump_hm_regs)];
+	int err[ARRAY_SIZE(nct6775_dump_hm_regs)];
+	int i;
+
+	if (!READ_ONCE(dump))
+		return -EPERM;
+
+	mutex_lock(&data->update_lock);
+	for (i = 0; i < ARRAY_SIZE(nct6775_dump_hm_regs); i++)
+		err[i] = nct6775_dump_hm_read(data, nct6775_dump_hm_regs[i], &val[i]);
+	mutex_unlock(&data->update_lock);
+
+	seq_printf(s, "# %s hardware monitor at %#x: SMI/OVT configuration, read-only\n",
+		   data->name, data->addr & IOREGION_ALIGNMENT);
+	seq_puts(s, "# never read (read-to-clear):");
+	for (i = 0; i < ARRAY_SIZE(nct6775_dump_never_read); i++)
+		seq_printf(s, " 0x%03x", nct6775_dump_never_read[i]);
+	seq_putc(s, '\n');
+
+	for (i = 0; i < ARRAY_SIZE(nct6775_dump_hm_regs); i++) {
+		if (err[i] == -EPERM)
+			seq_printf(s, "0x%03x = denied\n", nct6775_dump_hm_regs[i]);
+		else if (err[i])
+			seq_printf(s, "0x%03x = error %d\n", nct6775_dump_hm_regs[i], err[i]);
+		else
+			seq_printf(s, "0x%03x = 0x%02x\n", nct6775_dump_hm_regs[i], val[i]);
+	}
+	return 0;
+}
+DEFINE_SHOW_ATTRIBUTE(nct6775_hm_regs);
+
+static int nct6775_sio_regs_show(struct seq_file *s, void *unused)
+{
+	struct nct6775_data *data = s->private;
+	struct nct6775_sio_data *sio_data = data->driver_data;
+	int val[NCT6775_DUMP_SIO_MAX];	/* the register, or -EPERM: not read */
+	int i, n, reg, ld, cur, err;
+
+	if (!READ_ONCE(dump))
+		return -EPERM;
+
+	for (i = 0, n = 0; i < ARRAY_SIZE(nct6775_dump_sio_regs); i++)
+		n += nct6775_dump_sio_regs[i].last - nct6775_dump_sio_regs[i].first + 1;
+	if (WARN_ON_ONCE(n > ARRAY_SIZE(val)))
+		return -E2BIG;
+
+	/*
+	 * Enter and leave configuration mode exactly as probe and resume do,
+	 * holding the region so other Super-I/O drivers wait. Only the
+	 * logical-device select is written, and it is put back afterwards.
+	 */
+	mutex_lock(&data->update_lock);
+	err = sio_data->sio_enter(sio_data);
+	if (err) {
+		mutex_unlock(&data->update_lock);
+		return err;
+	}
+
+	ld = sio_data->sio_inb(sio_data, SIO_REG_LDSEL);
+	cur = ld;
+	n = 0;
+	for (i = 0; i < ARRAY_SIZE(nct6775_dump_sio_regs); i++) {
+		int dev = nct6775_dump_sio_regs[i].ld;
+
+		if (dev >= 0 && dev != cur) {
+			cur = dev;
+			sio_data->sio_select(sio_data, cur);
+		}
+		for (reg = nct6775_dump_sio_regs[i].first;
+		     reg <= nct6775_dump_sio_regs[i].last; reg++, n++) {
+			if (nct6775_dump_sio_denied(dev, reg))
+				val[n] = -EPERM;
+			else
+				val[n] = sio_data->sio_inb(sio_data, reg);
+		}
+	}
+	if (cur != ld)
+		sio_data->sio_select(sio_data, ld);
+
+	sio_data->sio_exit(sio_data);
+	mutex_unlock(&data->update_lock);
+
+	seq_printf(s, "# %s Super-I/O at %#x: configuration registers, read-only\n",
+		   data->name, sio_data->sioreg);
+	seq_puts(s, "# never read (read-to-clear):");
+	for (i = 0; i < ARRAY_SIZE(nct6775_dump_sio_never_read); i++)
+		seq_printf(s, " LDN%02X:CR%02X", nct6775_dump_sio_never_read[i].ld,
+			   nct6775_dump_sio_never_read[i].reg);
+	seq_putc(s, '\n');
+	n = 0;
+	for (i = 0; i < ARRAY_SIZE(nct6775_dump_sio_regs); i++) {
+		for (reg = nct6775_dump_sio_regs[i].first;
+		     reg <= nct6775_dump_sio_regs[i].last; reg++, n++) {
+			if (nct6775_dump_sio_regs[i].ld < 0)
+				seq_printf(s, "CR%02X = ", reg);
+			else
+				seq_printf(s, "LDN%02X CR%02X = ", nct6775_dump_sio_regs[i].ld, reg);
+			if (val[n] < 0)
+				seq_puts(s, "denied\n");
+			else
+				seq_printf(s, "0x%02x\n", val[n]);
+		}
+	}
+	return 0;
+}
+DEFINE_SHOW_ATTRIBUTE(nct6775_sio_regs);
+
+static void nct6775_debugfs_remove(void *dir)
+{
+	debugfs_remove_recursive(dir);
+}
+
+static void nct6775_debugfs_init(struct device *dev, struct nct6775_data *data)
+{
+	struct nct6775_sio_data *sio_data = data->driver_data;
+	struct dentry *dir;
+
+	if (sio_data->access != access_direct ||
+	    (data->kind != nct6796 && data->kind != nct6799))
+		return;
+
+	dir = debugfs_create_dir(dev_name(dev), nct6775_debugfs_root);
+	debugfs_create_file("sio_regs", 0400, dir, data, &nct6775_sio_regs_fops);
+	debugfs_create_file("hm_regs", 0400, dir, data, &nct6775_hm_regs_fops);
+
+	/* Removed before the rest of the device's resources are released */
+	if (devm_add_action_or_reset(dev, nct6775_debugfs_remove, dir))
+		dev_warn(dev, "register dump not available\n");
+}
+
 static const struct regmap_config nct6775_regmap_config = {
 	.reg_bits = 16,
 	.val_bits = 16,
@@ -945,6 +1226,7 @@
 	struct nct6775_data *data;
 	struct resource *res;
 	const struct regmap_config *regmapcfg;
+	int err;
 
 	if (sio_data->access == access_direct) {
 		res = platform_get_resource(pdev, IORESOURCE_IO, 0);
@@ -971,7 +1253,12 @@
 	data->driver_data = sio_data;
 	data->driver_init = nct6775_platform_probe_init;
 
-	return nct6775_probe(&pdev->dev, data, regmapcfg);
+	err = nct6775_probe(&pdev->dev, data, regmapcfg);
+	if (err)
+		return err;
+
+	nct6775_debugfs_init(&pdev->dev, data);
+	return 0;
 }
 
 static struct platform_driver nct6775_driver = {
@@ -1534,9 +1821,14 @@
 	enum sensor_access access = access_direct;
 	const char *board_vendor, *board_name;
 
+	/* The device directories go here, so it must exist before any probe */
+	nct6775_debugfs_root = debugfs_create_dir(DRVNAME, NULL);
+
 	err = platform_driver_register(&nct6775_driver);
-	if (err)
+	if (err) {
+		debugfs_remove_recursive(nct6775_debugfs_root);
 		return err;
+	}
 
 	board_vendor = dmi_get_system_info(DMI_BOARD_VENDOR);
 	board_name = dmi_get_system_info(DMI_BOARD_NAME);
@@ -1633,6 +1925,7 @@
 		platform_device_unregister(pdev[i]);
 exit_unregister:
 	platform_driver_unregister(&nct6775_driver);
+	debugfs_remove_recursive(nct6775_debugfs_root);
 	return err;
 }
 
@@ -1643,6 +1936,7 @@
 	for (i = 0; i < ARRAY_SIZE(pdev); i++)
 		platform_device_unregister(pdev[i]);
 	platform_driver_unregister(&nct6775_driver);
+	debugfs_remove_recursive(nct6775_debugfs_root);
 }
 
 MODULE_AUTHOR("Guenter Roeck <linux@roeck-us.net>");
